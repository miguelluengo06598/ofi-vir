{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:all": "bash scripts/dev-all.sh",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "test:db": "supabase test db",
    "prueba:lucia": "node --env-file=.env.local scripts/prueba-lucia.ts",
    "cron": "node --env-file=.env.local scripts/cron.ts",
    "prueba:asistente": "node --env-file=.env.local scripts/prueba-asistente.ts",
    "plantillas:sync": "node --env-file=.env.local scripts/sincronizar-plantillas.ts",
    "db:reset": "supabase db reset && npm run plantillas:sync -- --datos-de-prueba",
    "test:creditos": "node --env-file=.env.local --test --test-concurrency=1 \"tests/creditos/*.test.ts\"",
    "prueba:conexiones": "node --env-file=.env.local scripts/prueba-conexiones.ts",
    "test:traspasos": "node --env-file=.env.local --test --test-concurrency=1 \"tests/traspasos/*.test.ts\"",
    "prueba:traspasos": "node --env-file=.env.local scripts/prueba-traspasos.ts",
    "prueba:simulador": "node --env-file=.env.local scripts/prueba-simulador.ts",
    "prueba:certificacion": "node --env-file=.env.local scripts/prueba-certificacion.ts",
    "test:panel": "node --env-file=.env.local --test --test-concurrency=1 \"tests/panel/*.test.ts\"",
    "test:ciclo": "node --env-file=.env.local --test --test-concurrency=1 \"tests/ciclo/*.test.ts\"",
    "certificacion:cambio-modelo": "node --env-file=.env.local scripts/examen-cambio-modelo.ts",
    "test:certificacion": "node --env-file=.env.local --test tests/certificacion/*.test.ts",
    "test:simulador": "node --env-file=.env.local --test --test-concurrency=1 \"tests/simulador/*.test.ts\"",
    "test:reglas": "node --env-file=.env.local --test --test-concurrency=1 \"tests/reglas/*.test.ts\"",
    "test:conexiones": "node --env-file=.env.local --test --test-concurrency=1 \"tests/conexiones/*.test.ts\"",
    "test:admin": "node --env-file=.env.local --test --test-concurrency=1 \"tests/admin/*.test.ts\"",
    "test:seguridad": "node --env-file=.env.local --test --test-concurrency=1 \"tests/seguridad/*.test.ts\"",
    "test": "node --test \"src/lib/*/*.test.ts\"",
    "prueba:conocimiento": "node --env-file=.env.local scripts/prueba-conocimiento.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "svix": "^2.9.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
