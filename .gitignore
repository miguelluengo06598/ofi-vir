# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla sin valores sí se versiona.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Informes generados por scripts (p. ej. examen por cambio de modelo)
/informes/

# Supabase CLI (también en supabase/.gitignore; aquí por si se borra aquel)
supabase/.temp/
supabase/.branches/
supabase/.env.keys

# Variables de entorno: cubiertas por `.env*` arriba (.env, .env.local, .env.*.local)

# Logs
logs/
*.log

# Editores y sistema
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db

# Pruebas y cobertura (cualquier carpeta coverage)
coverage/
.nyc_output/

# Datos reales, volcados y copias de seguridad: nunca al repositorio
*.dump
*.backup
*.bak
*.sql.gz
*.sqlite
*.sqlite3
/backups/
/copias/
/exports/
/datos-reales/
supabase/backups/

# Vídeos del producto: se generan con `npm run videos` y se alojan fuera de git (ver src/config/videos.ts)
/public/videos/
/videos/node_modules/
/videos/salida/

/videos/public/scenes/
