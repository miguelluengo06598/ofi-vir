# =====================================================================================================================
# Variables de entorno de Oficina Virtual IA
# =====================================================================================================================
# Copia este archivo a .env.local y rellena los valores. .env.local NO se sube a git (está en .gitignore).
# En Vercel, ponlas en Project → Settings → Environment Variables (una por entorno: Production / Preview / Development).
#
# Leyenda de cada variable:
#   [OBLIGATORIA] la app (o esa función) no arranca sin ella · [OPCIONAL] tiene un valor por defecto o se puede omitir
#   [SERVIDOR]    solo la lee el servidor; nunca llega al navegador
#   [NAVEGADOR]   lleva el prefijo NEXT_PUBLIC_ y se incrusta en el JavaScript público: NUNCA pongas ahí un secreto
#   [SOLO LOCAL]  nunca la definas en Vercel Production
# =====================================================================================================================

# --- Supabase ---------------------------------------------------------------------------------------------------------
# En local este proyecto usa los puertos 5542x (API en http://127.0.0.1:55421). `supabase status -o env` muestra:
#   API_URL -> NEXT_PUBLIC_SUPABASE_URL · ANON_KEY -> NEXT_PUBLIC_SUPABASE_ANON_KEY · SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY
# En la nube: Supabase → Project Settings → API (URL del proyecto, clave anon/publishable y clave service_role/secret).

# [OBLIGATORIA] [NAVEGADOR] URL de la API de Supabase. Pública por diseño.
NEXT_PUBLIC_SUPABASE_URL=
# [OBLIGATORIA] [NAVEGADOR] Clave pública «anon» de Supabase. Pública por diseño: la seguridad la da Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [OBLIGATORIA] [SERVIDOR] Clave service_role: se salta Row Level Security. Solo en código de servidor, jamás NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# [OBLIGATORIA en producción] [NAVEGADOR] URL canónica sin barra final. Auth la usa para construir
# los callback de confirmación, enlace mágico y recuperación. En Vercel Preview se puede definir
# por entorno con la URL concreta de la preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [OPCIONAL] [SERVIDOR] `true` permite el registro abierto y crea una empresa con la persona como
# propietaria. Vacío o `false` lo cierra: solo se puede entrar mediante una invitación válida.
REGISTRO_ABIERTO=false

# [OPCIONAL] [SERVIDOR] Reserva para habilitar Google cuando se configure en Supabase Auth.
# La interfaz lo mantiene desactivado mientras sea `false`.
GOOGLE_OAUTH_ENABLED=false

# --- Dirección pública de la aplicación ---------------------------------------------------------------------------------
# [OBLIGATORIA en producción] [SERVIDOR] URL pública sin barra final (p. ej. https://oficina.ejemplo.com).
# Se usa para el redirect_uri de OAuth y los enlaces internos. En local, si falta, se usa http://localhost:3000.
APP_URL=

# --- Anthropic (agentes) ----------------------------------------------------------------------------------------------
# [OBLIGATORIA para ejecutar agentes] [SERVIDOR] Clave de la API de Claude. console.anthropic.com → API Keys.
# Sin ella la interfaz funciona, pero los agentes, el asistente, el simulador y los exámenes no se ejecutan.
ANTHROPIC_API_KEY=

# --- Voyage (embeddings de la memoria) ------------------------------------------------------------------------------
# [OPCIONAL] [SERVIDOR] Clave de Voyage AI (dashboard.voyageai.com → API Keys). Modelo voyage-3.5 a 1024 dimensiones.
# Sin ella la memoria funciona sin búsqueda semántica y no se procesa el conocimiento de los agentes.
VOYAGE_API_KEY=

# --- Resend (correo) --------------------------------------------------------------------------------------------------
# [OBLIGATORIA para enviar correo] [SERVIDOR] Clave de la API de Resend (resend.com → API Keys).
RESEND_API_KEY=
# [OBLIGATORIA para enviar correo] [SERVIDOR] Remitente de un dominio verificado en Resend (Domains).
RESEND_FROM_EMAIL=
# [OBLIGATORIA para recibir respuestas] [SERVIDOR] Dirección de recepción de Resend (Emails → Receiving).
RESEND_REPLY_TO=
# [OBLIGATORIA para los webhooks] [SERVIDOR] Secreto de firma del webhook /api/webhooks/resend (empieza por whsec_).
# Resend → Webhooks → el endpoint → Signing secret. Sin él, el webhook responde 503.
RESEND_WEBHOOK_SECRET=
# [OPCIONAL] [SERVIDOR] Secreto del webhook de correo ENTRANTE (/api/webhooks/resend-inbound) si es otro endpoint.
# Vacío = se usa RESEND_WEBHOOK_SECRET.
RESEND_INBOUND_WEBHOOK_SECRET=
# [OPCIONAL] [SERVIDOR] Slug del agente que atiende correos de remitentes sin hilo previo (p. ej. sofia-navarro).
INBOUND_DEFAULT_AGENT_SLUG=
# [SOLO LOCAL] [OPCIONAL] [SERVIDOR] Fuera de producción solo se envía a las direcciones de prueba de Resend y a estas
# (separadas por comas; las tuyas). En producción se ignora.
EMAIL_DEV_ALLOWLIST=

# --- Interruptores de los agentes --------------------------------------------------------------------------------------
# [OPCIONAL] [SERVIDOR] `false` impide ejecutar CUALQUIER agente en este servidor, diga lo que diga la base (interruptor de
# seguridad). Sin definir o `true` = los agentes trabajan (siempre con un motivo: evento, orden, rutina, traspaso o seguimiento).
AGENTES_ACTIVOS=
# [OPCIONAL] [SERVIDOR] `true` activa los procesos internos automáticos de SAMGPLE con IA: muestreo de calidad y exámenes de
# recertificación periódica. Sin definir o `false` = desactivados (así deben estar en pruebas y en local).
CONTROL_CALIDAD_AUTOMATICO=false

# --- Tareas periódicas (/api/cron/<tarea>) ------------------------------------------------------------------------------
# [OBLIGATORIA en producción] [SERVIDOR] Secreto de las rutas de cron (mínimo 16 caracteres; `openssl rand -hex 24`).
# Vercel Cron lo envía solo como `Authorization: Bearer <CRON_SECRET>`. Sin ella, las rutas responden 503.
# Los crons frecuentes los lanza Supabase (pg_cron): guarda el mismo valor en su Vault como `cron_secret`
# y la URL pública de la web como `cron_app_url` (ver supabase/migrations/20261115000000_crons_supabase.sql).
CRON_SECRET=

# --- Conexiones con aplicaciones externas (src/lib/integraciones/) ----------------------------------------------------
# [OBLIGATORIA para conectar aplicaciones] [SERVIDOR] Secreto para firmar el `state` de OAuth (mínimo 32 caracteres;
# `openssl rand -hex 32`). Sin él, las conexiones están cerradas (503).
CONEXIONES_STATE_SECRET=
# [OPCIONAL] [SERVIDOR] Cada proveedor real usa CONEXION_<ID>_AUTH_URL, _TOKEN_URL, _REVOKE_URL (opcional), _CLIENT_ID y
# _CLIENT_SECRET (este último secreto). IDs: HUBSPOT, GOOGLE_CALENDAR, META_ADS. Se sacan de la consola de
# desarrolladores de cada proveedor; crea una app OAuth distinta por entorno. Sin ellas, ese proveedor no aparece.
# CONEXION_HUBSPOT_AUTH_URL=
# CONEXION_HUBSPOT_TOKEN_URL=
# CONEXION_HUBSPOT_REVOKE_URL=
# CONEXION_HUBSPOT_CLIENT_ID=
# CONEXION_HUBSPOT_CLIENT_SECRET=
# CONEXION_GOOGLE_CALENDAR_AUTH_URL=
# CONEXION_GOOGLE_CALENDAR_TOKEN_URL=
# CONEXION_GOOGLE_CALENDAR_REVOKE_URL=
# CONEXION_GOOGLE_CALENDAR_CLIENT_ID=
# CONEXION_GOOGLE_CALENDAR_CLIENT_SECRET=
# CONEXION_META_ADS_AUTH_URL=
# CONEXION_META_ADS_TOKEN_URL=
# CONEXION_META_ADS_REVOKE_URL=
# CONEXION_META_ADS_CLIENT_ID=
# CONEXION_META_ADS_CLIENT_SECRET=
# [SOLO LOCAL] [OPCIONAL] [SERVIDOR] `true` activa el proveedor «demo» (OAuth falso). En producción se ignora.
CONEXIONES_DEMO=
# [SOLO LOCAL] [OPCIONAL] [SERVIDOR] Secreto del cliente del proveedor demo (por defecto «demo-secret»; no es una clave real).
CONEXION_DEMO_CLIENT_SECRET=
# [SOLO LOCAL] [OPCIONAL] [SERVIDOR] Segundos de vida del token demo (pon 60 para ver la renovación automática).
DEMO_TOKEN_TTL_SEGUNDOS=

# --- Compras de créditos simuladas --------------------------------------------------------------------------------------
# [SOLO LOCAL] [OPCIONAL] [SERVIDOR] `true` = /api/creditos/comprar añade créditos SIN cobrar. En producción la ruta se
# niega siempre (hasta Stripe). Déjala vacía en cualquier entorno publicado.
PAGOS_SIMULADOS=

# --- Persona de desarrollo (mientras no haya inicio de sesión) ----------------------------------------------------------
# [SOLO LOCAL] Solo se usan fuera de producción y sin cabecera Authorization. NUNCA en Vercel.
# [OPCIONAL] [SERVIDOR] Empresa (uuid de public.companies). Con la semilla: a64499d1-7f43-4a43-abc8-41a313dc4018
DEV_COMPANY_ID=
# [OPCIONAL] [SERVIDOR] Persona que firma (uuid de public.users de esa empresa). Semilla (Marcos): 0c33590a-4c2a-4b32-a388-2008558688f7
DEV_USER_ID=
# [OPCIONAL] [SERVIDOR] Revisor de certificación de desarrollo (uuid de public.users con rol de revisor).
DEV_REVISOR_USER_ID=
# [OPCIONAL] [SERVIDOR] Persona admin_samgple (platform_roles) para los paneles internos. Semilla: 1de51e00-0000-4000-8000-0000000000a1 (admin@samgple.example)
DEV_ADMIN_USER_ID=

# --- Tarifas de IA y economía (src/lib/creditos/tarifas.ts) ---------------------------------------------------------------
# [OPCIONAL] [SERVIDOR] Dólares por MILLÓN de tokens; sin valor se usan los de por defecto
# (Haiku 0,10 entrada / 0,50 salida / 0,01 caché; Sonnet 2 / 10 / 0,10). Fuente: la página de precios de Anthropic.
PRECIO_HAIKU_ENTRADA_USD=
PRECIO_HAIKU_SALIDA_USD=
PRECIO_HAIKU_CACHE_USD=
PRECIO_SONNET_ENTRADA_USD=
PRECIO_SONNET_SALIDA_USD=
PRECIO_SONNET_CACHE_USD=
# [OPCIONAL] [SERVIDOR] Dólares por euro (por defecto 1,08). Solo para comparar coste de IA y cobro en el panel de márgenes.
CAMBIO_USD_POR_EUR=
# [OPCIONAL] [SERVIDOR] Simulaciones gratis al mes por empresa (por defecto 50; 0 = todas se cobran como tarea simple).
SIMULACIONES_GRATIS_MES=
# [OPCIONAL] [SERVIDOR] Tope de coste de IA por examen de certificación, en micros de dólar (por defecto 5000000 = 5 USD).
EXAMEN_COSTE_MAXIMO_USD_MICROS=
# [OPCIONAL] [SERVIDOR] Plazo objetivo de revisión humana, en horas (enteros positivos), por vía de certificación.
REVISION_PLAZO_COMPLETA_HORAS=
REVISION_PLAZO_RAPIDA_HORAS=

# --- Pruebas ----------------------------------------------------------------------------------------------------------
# [SOLO LOCAL] [OPCIONAL] Dirección del servidor que atacan las pruebas HTTP de `npm run test:seguridad`
# (por defecto APP_URL o http://localhost:3000).
SEC_BASE_URL=

# NODE_ENV no se define a mano: lo ponen Next.js y Vercel (production en `next build`/`next start` y en Vercel).

# Vídeos del producto: URL base del alojamiento (sin barra final). Vacío = /videos (public/videos, solo local).
NEXT_PUBLIC_VIDEOS_BASE_URL=
