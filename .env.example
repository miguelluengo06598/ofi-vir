# Copia este archivo a .env.local y rellena los valores. .env.local NO se sube a git.
# Las variables con prefijo NEXT_PUBLIC_ llegan al navegador: nunca pongas ahí un secreto.

# --- Supabase (local) -------------------------------------------------------
# Este proyecto usa los puertos 5542x (API en http://127.0.0.1:55421) para no chocar con otros proyectos de Supabase.
# Con Supabase arrancado, `supabase status -o env` muestra los valores:
#   API_URL      -> NEXT_PUBLIC_SUPABASE_URL
#   ANON_KEY     -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Se salta Row Level Security: no usarla en código que corra en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (correo) --------------------------------------------------------
# Solo servidor.
RESEND_API_KEY=
# Dirección remitente de un dominio verificado en Resend.
RESEND_FROM_EMAIL=
# Dirección de recepción: a ella llegan las respuestas de los clientes (Resend → Emails → Receiving).
RESEND_REPLY_TO=
# Secreto para verificar la firma de los webhooks de Resend (empieza por whsec_).
RESEND_WEBHOOK_SECRET=
# Secreto del webhook de correo ENTRANTE (/api/webhooks/resend-inbound), si lo creas como un endpoint aparte en Resend.
# Si usas un solo endpoint para todo, déjalo vacío: se usa RESEND_WEBHOOK_SECRET.
RESEND_INBOUND_WEBHOOK_SECRET=
# Agente (slug) que lleva los correos de remitentes que no tienen ningún hilo previo, p. ej. sofia-navarro (Atención al cliente).
INBOUND_DEFAULT_AGENT_SLUG=
# Solo en desarrollo: direcciones reales, separadas por comas, a las que SÍ se permite enviar (las tuyas).
# Además de estas, solo se envía a las de prueba de Resend (delivered@resend.dev, bounced@resend.dev, complained@resend.dev).
EMAIL_DEV_ALLOWLIST=

# --- Anthropic (agentes) ----------------------------------------------------
# Solo servidor.
ANTHROPIC_API_KEY=

# --- Voyage (embeddings de la memoria) -------------------------------------
# Solo servidor. Modelo voyage-3.5 a 1024 dimensiones. Sin clave, la vista Memoria sigue funcionando (sin búsqueda semántica).
VOYAGE_API_KEY=

# --- Empresa de desarrollo --------------------------------------------------
# Mientras no exista el inicio de sesión, el servidor usa esta empresa (uuid de public.companies).
# Con la semilla: a64499d1-7f43-4a43-abc8-41a313dc4018
DEV_COMPANY_ID=
# Persona que firma las aprobaciones mientras no exista el inicio de sesión (uuid de public.users, de esa empresa).
# Con la semilla (Marcos, propietario): 0c33590a-4c2a-4b32-a388-2008558688f7
DEV_USER_ID=
